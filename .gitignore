# See https://www.dartlang.org/guides/libraries/private-files

# wordbuddy
.workbuddy-ai/

# Local tooling shims (a stub Android SDK so the Flutter tool skips its
# `where aapt` probe on this machine).
.tooling/

# IDE
.idea/
*.iml

# Files and directories created by pub
.dart_tool/
.packages
build/
# NOTE: the Flutter template ignores `pubspec.lock` with a "you may want to
# check-in your pubspec.lock" comment. This is an application, not a library, so
# it is committed: a release has to resolve exactly the versions the local build
# did. Without it CI takes whatever is newest-compatible, and a release can
# break on a day when nothing in this repository changed.

# Directory created by dartdoc
# If you don't generate documentation locally you can remove this line.
doc/api/

# dotenv environment variables file
.env*

# Avoid committing generated Javascript files:
*.dart.js
# Produced by the --dump-info flag.
*.info.json
# When generated by dart2js. Don't specify *.js if your
# project includes source files written in JavaScript.
*.js
*.js_
*.js.deps
*.js.map

.flutter-plugins
.flutter-plugins-dependencies

# The backend is a separate repository; keep it out of this one.
# (Use `git submodule add` if it should be tracked here.)
smartclass-webcam-server/

# Scratch terminal dumps pasted into the workspace.
output_temp.txt

# Android release signing. `key.properties` points at the keystore and holds its
# passwords; CI writes it from repository secrets and never commits it.
android/key.properties
*.jks
*.keystore
